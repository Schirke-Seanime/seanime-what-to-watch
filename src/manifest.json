  "website": "https://github.com/Schirke/seanime-what-to-watch",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/Schirke/seanime-what-to-watch/main/src/WhatToWatch.ts",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "anilist",
        "anilist-token",
        "database",
        "storage"
      ]
    }
  }
}
